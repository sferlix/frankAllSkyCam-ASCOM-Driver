{
  "AllSkyWeather": {
    "SourceUrl": "https://www.meteobrallo.com/webcam/allsky/weather.json",
    "PollIntervalSeconds": 60,
    "HttpPort": 51111,
    "DeviceName": "AllSky Weather"
  },
  "SafetyMonitor": {
    "DeviceName": "AllSky Safety Monitor",
    "MaxDataAgeMinutes": 10,
    "CloudCover": { "Enabled": true, "Threshold": 80 },
    "RainRate": { "Enabled": true, "Threshold": 0 },
    "WindGust": { "Enabled": true, "Threshold": 15 },
    "WindSpeed": { "Enabled": false, "Threshold": 12 },
    "SkyBrightness": { "Enabled": true, "Threshold": 1000 },
    "Humidity": { "Enabled": false, "Threshold": 90 },
    "DewPoint": { "Enabled": false, "Threshold": 20 },
    "SkyQuality": { "Enabled": false, "Threshold": 18 },
    "TemperatureMin": { "Enabled": false, "Threshold": -10 },
    "PressureMin": { "Enabled": false, "Threshold": 990 },
    "StarCountMin": { "Enabled": false, "Threshold": 3 },
    "NightWindowEnabled": false
  },
  "Notifications": {
    "Enabled": false,
    "TelegramBotToken": "",
    "TelegramChatId": ""
  }
}
